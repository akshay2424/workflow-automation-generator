# Copy this file to .env and fill in your key: cp .env.example .env
#
# Get a free Groq API key (no credit card required) at:
#   https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional overrides -- defaults shown below. If a model ever returns a
# 404 "model_not_found" error, Groq's available models may have changed --
# check https://console.groq.com/docs/models for current production model
# IDs and update these.
EXTRACTION_MODEL=openai/gpt-oss-20b
ESCALATION_MODEL=openai/gpt-oss-120b
